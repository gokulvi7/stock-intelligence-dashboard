# Copy this file to .env and adjust as needed. All values are optional -
# sensible defaults are used if a variable is not set.

# SQLite database file location
DATABASE_PATH=data/cache/stock_intelligence.db

# Yahoo Finance retrieval
PRICE_HISTORY_PERIOD=1y
PRICE_CACHE_TTL_SECONDS=900
INFO_CACHE_TTL_SECONDS=900
NEWS_CACHE_TTL_SECONDS=900
MAX_NEWS_PER_TICKER=15
MAX_TICKERS_PER_UPLOAD=50

# Sentiment model (HuggingFace hub id). Falls back to a local lexicon
# scorer automatically if this cannot be downloaded/loaded.
FINBERT_MODEL_NAME=ProsusAI/finbert

# Logging
LOG_LEVEL=INFO
